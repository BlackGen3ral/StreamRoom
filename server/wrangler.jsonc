{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamroom-signaling-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "streamroom.arthostudio.com", "custom_domain": true }],
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "MULTI_ROOMS", "class_name": "MultiRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["MultiRoom"] }],
  "ratelimits": [{ "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}

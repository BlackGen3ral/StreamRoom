{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamroom-turn-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [],
  "observability": { "enabled": false },
  "vars": { "TURN_EXPERIMENT": "true", "TURN_TEST_EXPIRES_AT": "DISABLED", "TURN_TEST_ROOM_ID": "DISABLED" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "MULTI_ROOMS", "class_name": "MultiRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["MultiRoom"] }],
  "ratelimits": [{ "name": "CREATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 2, "period": 60 } }]
}

<Window x:Class="StreamRoom.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamRoom · Etapa 1" Width="1080" Height="760" MinWidth="860" MinHeight="660" Background="#0E1119" WindowStartupLocation="CenterScreen">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <StackPanel><TextBlock Text="StreamRoom" FontSize="30" FontWeight="Bold"/><TextBlock Text="Seu jogo. Sua sala. Seus amigos." Foreground="#9CA6BE" Margin="0,5,0,0"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#242039" CornerRadius="12" Padding="14,7"><TextBlock Text="ETAPA 1 · SALAS" Foreground="#BFB2FF" FontSize="12" FontWeight="SemiBold"/></Border>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Início" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <StackPanel x:Name="ConnectionFields">
              <TextBlock Text="Seu nome"/><TextBox x:Name="NameInput" MaxLength="32" Text="Jogador" AutomationProperties.Name="Seu nome"/>
              <TextBlock Text="Servidor de salas"/><TextBox x:Name="ServerInput" Text="https://streamroom-signaling-dev.arthurgabrielfera.workers.dev" AutomationProperties.Name="Servidor de salas"/>
              <Button x:Name="HealthButton" Content="Verificar servidor" Click="CheckServer_Click" Background="#30364A" HorizontalAlignment="Left" Margin="0,0,0,22"/>
              <Button x:Name="CreateButton" Content="Criar uma sala" Click="Create_Click"/>
              <TextBlock Text="ou entre com um convite" Foreground="#9CA6BE" Margin="0,22,0,8"/>
              <TextBox x:Name="InviteInput" AutomationProperties.Name="Convite" TextWrapping="Wrap" MinHeight="65"/>
              <Button x:Name="JoinButton" Content="Entrar na sala" Click="Join_Click" Background="#30364A"/>
            </StackPanel>
            <TextBlock Text="O servidor e seu nome são salvos neste computador. Os convites ficam apenas na memória da sessão." Foreground="#9CA6BE" TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="RoomTitle" Text="Sua sala" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock x:Name="RoomInfo" Grid.Row="1" Text="Crie uma sala ou cole um convite para começar." TextWrapping="Wrap" Foreground="#9CA6BE" Margin="0,10,0,18"/>
          <ListBox x:Name="ParticipantsList" Grid.Row="2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate>
              <Border Background="#222738" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                <StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding RoleLabel}" Foreground="#A99DDC" Margin="0,4,0,0"/></StackPanel>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3">
            <TextBlock Text="Captura de jogo, áudio e player chegam nas próximas etapas. Esta versão conecta participantes à sala." Foreground="#9CA6BE" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,20"/>
            <Button x:Name="CopyButton" Content="Copiar convite" Click="Copy_Click" IsEnabled="False" Margin="0,0,0,10"/>
            <Button x:Name="LeaveButton" Content="Sair da sala" Click="Leave_Click" Background="#30364A" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#151925" CornerRadius="8" Padding="14" Margin="0,20,0,0">
      <TextBlock x:Name="StatusText" Text="Pronto para conectar. Nenhuma transmissão iniciada." Foreground="#B4BFD7" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
